# Where the landing page contact form posts.
# Any handler that accepts JSON { email, note, source } works: your own
# API route, a Cloudflare Worker, Formspree, Basin, Netlify Forms.
# Leave it unset and the form hands the visitor a prefilled mail draft
# instead of reporting a success nobody received.
VITE_CONTACT_ENDPOINT=

# Mailbox used for that fallback draft and shown on the panel.
VITE_CONTACT_MAILBOX=hello@bosssystems.co
